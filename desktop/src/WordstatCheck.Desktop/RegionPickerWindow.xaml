<Window x:Class="WordstatCheck.Desktop.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор регионов" Width="680" Height="720" MinWidth="520" MinHeight="520"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Выбор регионов" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="Можно выбрать несколько. Если ничего не отмечено, проверка идёт без регионального фильтра."
                 Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,18" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Поиск" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBox x:Name="SearchBox" Grid.Column="2" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по названию или ID" />
    </Grid>

    <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12">
      <ListBox x:Name="RegionsList" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="RegionCheck_Changed" Unchecked="RegionCheck_Changed" Padding="6" Margin="4,3">
              <StackPanel>
                <TextBlock Text="{Binding Region.Name}" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap">
                  <Run Text="{Binding Region.Path}" /><Run Text="  ·  ID " /><Run Text="{Binding Region.Id}" />
                </TextBlock>
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="SelectedCountText" FontWeight="SemiBold" />
        <Button Content="Сбросить" Click="Clear_Click" Padding="0" MinHeight="24" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" />
      </StackPanel>
      <Button Grid.Column="2" Content="Отмена" Click="Cancel_Click" />
      <Button Grid.Column="4" Content="Применить" Click="Apply_Click" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" />
    </Grid>
  </Grid>
</Window>
