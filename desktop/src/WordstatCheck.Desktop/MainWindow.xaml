<Window x:Class="WordstatCheck.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WORDSTATCHEK" Width="1040" Height="760" MinWidth="860" MinHeight="650"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen">
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="18" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="WORDSTATCHEK" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Accent}" />
        <TextBlock Text="Массовая проверка ключевых фраз" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
      </StackPanel>
      <Border DockPanel.Dock="Right" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
        <TextBlock Text="Yandex Wordstat API · checkpoint · Excel" Foreground="{StaticResource Muted}" />
      </Border>
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="0.95*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Настройка запуска" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Ключ остаётся только в памяти приложения и не записывается в checkpoint или журнал." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,22" />

            <TextBlock Text="Входной TXT" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="InputPathBox" Grid.Column="0" />
              <Button Grid.Column="2" Content="Выбрать" Click="ChooseInput_Click" />
            </Grid>

            <TextBlock Text="Папка результатов" FontWeight="SemiBold" Margin="0,18,0,6" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox x:Name="OutputPathBox" Grid.Column="0" />
              <Button Grid.Column="2" Content="Выбрать" Click="ChooseOutput_Click" />
            </Grid>

            <TextBlock Text="Yandex Search API Key" FontWeight="SemiBold" Margin="0,18,0,6" />
            <PasswordBox x:Name="ApiKeyBox" />

            <TextBlock Text="Yandex Cloud Folder ID" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBox x:Name="FolderIdBox" />

            <TextBlock Text="Регионы" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBox x:Name="RegionsBox" ToolTip="ID регионов через запятую; пусто — без фильтра" />

            <TextBlock Text="Устройство" FontWeight="SemiBold" Margin="0,18,0,6" />
            <ComboBox x:Name="DeviceBox" MinHeight="40" Padding="8" SelectedIndex="0">
              <ComboBoxItem Content="Все устройства" Tag="" />
              <ComboBoxItem Content="Компьютеры" Tag="DEVICE_DESKTOP" />
              <ComboBoxItem Content="Телефоны" Tag="DEVICE_PHONE" />
              <ComboBoxItem Content="Планшеты" Tag="DEVICE_TABLET" />
            </ComboBox>

            <Grid Margin="0,24,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button x:Name="StartButton" Grid.Column="0" Content="Начать проверку" Click="Start_Click" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" />
              <Button x:Name="CancelButton" Grid.Column="2" Content="Остановить" Click="Cancel_Click" IsEnabled="False" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="24">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Ход выполнения" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="StatusText" Grid.Row="1" Text="Готово к запуску" Foreground="{StaticResource Muted}" Margin="0,8,0,16" />
          <StackPanel Grid.Row="2">
            <ProgressBar x:Name="RunProgress" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><TextBlock Text="Проверено" Foreground="{StaticResource Muted}" /><TextBlock x:Name="ProcessedText" Text="0 / 0" FontSize="18" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="Ненулевые" Foreground="{StaticResource Muted}" /><TextBlock x:Name="NonzeroText" Text="0" FontSize="18" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Нулевые" Foreground="{StaticResource Muted}" /><TextBlock x:Name="ZeroText" Text="0" FontSize="18" FontWeight="SemiBold" /></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="Ошибки" Foreground="{StaticResource Muted}" /><TextBlock x:Name="ErrorsText" Text="0" FontSize="18" FontWeight="SemiBold" /></StackPanel>
            </Grid>
          </StackPanel>
          <ListBox x:Name="ActivityList" Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FAFBFD" Padding="8" />
          <Button x:Name="OpenResultsButton" Grid.Row="5" Content="Открыть папку результатов" Click="OpenResults_Click" Margin="0,16,0,0" IsEnabled="False" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
